# Root env for docker compose. Copy to .env (never commit it).

# PostgreSQL
POSTGRES_USER=edu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=edu_platform
POSTGRES_PORT=5433

# Backend (generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
NODE_ENV=production
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
STORAGE_PROVIDER=local

# AI (provider abstraction; "mock" needs no key)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Email (class notifications). Leave SMTP_HOST empty to only log emails in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Public web app URL used for the buttons/links inside emails
FRONTEND_URL=http://localhost:3000
MAIL_FROM=EduSphere <no-reply@example.com>

# First platform admin (SUPER_ADMIN), created by the seed service
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Demo data is OFF by default. Set true only in development.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=password

# Frontend (inlined into the browser bundle at build time; must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Host ports
BACKEND_PORT=4000
FRONTEND_PORT=3000
