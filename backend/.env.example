PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://edu:edu_dev_password@localhost:5433/edu_platform?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
# Public URL of the web app (used for links in emails)
FRONTEND_URL=http://localhost:3000
# Use "none" when frontend and API are on different sites (Vercel + Render); needs HTTPS
COOKIE_SAMESITE=lax
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Email (SMTP). Leave SMTP_HOST empty to only log emails to the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduSphere <no-reply@example.com>

# Seed demo password (development only)
SEED_DEMO_PASSWORD=password
# Platform admin (SUPER_ADMIN) created/updated by the seed on every start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Separate database used only by `npm test` (demo data is seeded into it automatically)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/your_app_test?schema=public
# Set true to load demo schools/users/students (never in production)
SEED_DEMO_DATA=false
